{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AnlangA/openai-rs/blob/main/spec/contracts/manual-overrides.schema.json",
  "title": "openai-rs manual OpenAPI overrides",
  "description": "Validated last-resort corrections for conflicts that official machine contracts cannot express consistently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "overrides"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/override"
      }
    }
  },
  "$defs": {
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "action",
        "sources",
        "reviewed_at",
        "reason",
        "impact",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^OVR-[0-9]{4}$"
        },
        "target": {
          "type": "string",
          "description": "Local JSON Pointer into the pinned OpenAPI document.",
          "pattern": "^/(paths|webhooks|components)(/.*)?$"
        },
        "action": {
          "enum": ["replace", "merge", "remove", "quarantine"]
        },
        "value": {
          "description": "Replacement or merge value; omitted only when the action does not need one."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "sha256"],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "excerpt": {
                "type": "string"
              }
            }
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["replace", "merge"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "required": ["value"]
          }
        }
      ]
    }
  }
}
